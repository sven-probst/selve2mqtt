# MQTT Broker Settings
mqtt:
  broker: "localhost"      # MQTT Broker Hostname/IP
  port: 1883
  username: ""             # optional
  password: ""             # optional
  client_id: "selve2mqtt"
  discovery_prefix: "homeassistant"   # for Home Assistant MQTT Discovery

  # TLS / SSL Settings (optional)
  tls_enabled: false        # Set to true to connect via TLS/SSL (port auto-switched to 8883)
  tls_ca_certs: null        # Path to CA certificate file (null = system default CA bundle)
  tls_certfile: null        # Client certificate path for mutual TLS (mTLS) – leave null if unused
  tls_keyfile: null         # Client private key path for mutual TLS (mTLS) – leave null if unused
  tls_keyfile_password: null # Password for encrypted client private key – leave null if unused
  tls_insecure: false       # Skip hostname verification (only for self-signed certs / testing)
  tls_version: "auto"       # TLS version: "auto", "tlsv1_2", "tlsv1_3"

# Selve USB-RF Gateway
selve:
  port: "/dev/ttyUSB0"     # USB-Serial Port
  open_close_fix: false    # true: 0-1% -> 0% / 99-100% -> 100% (pos. correction)
  min_firmware_version: "2.0.0"
  command_delay_ms: 300    # Delay (ms) between gateway commands to prevent "Command overwritten" races

# General Settings
logging:
  level: "INFO"            # DEBUG, INFO, WARNING, ERROR
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
language: "de"             # Language code: de, en, es, fr, nl, pt, it

discovery_interval: 60      # Seconds between discovery runs (0 = disabled)
update_interval: 30         # Seconds between state updates

dashboard_token: ""         # Set a token to enable dashboard authentication

# Webserver (FastAPI)
web:
  host: "0.0.0.0"
  port: 8080